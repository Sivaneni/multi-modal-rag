PARSER_BACKEND=ollama      # "cloud" (Z.AI MaaS) | "ollama" (local Ollama)
Z_AI_API_KEY=
LOG_LEVEL=INFO
OUTPUT_DIR=./output
CONFIG_YAML_PATH=ollama/config.yaml
# --- MESH API -------------------------
MESH_API_KEY=rsk_

# LLM provider: "meshapi" (default) or "openai"
LLM_PROVIDER=meshapi

# OpenAI (embeddings only when LLM_PROVIDER=meshapi)
OPENAI_API_KEY=sk-proj
OPENAI_LLM_MODEL=openai/gpt-4o-mini

# Embedding provider
EMBEDDING_PROVIDER=openai        # "openai" | "gemini"
EMBEDDING_MODEL=text-embedding-3-large
# text-embedding-3-small: set EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_DIMENSIONS=1536
EMBEDDING_DIMENSIONS=3072
# ⚠ Changing EMBEDDING_DIMENSIONS after collection creation requires --overwrite

# Gemini (only needed if EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=                  # AIzaSy...

# Qdrant
QDRANT_URL=http://localhost:6333
#QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documentss


#neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password

# Reranker
RERANKER_BACKEND=jina      # "jina" | "openai" | "bge" | "qwen"
RERANKER_TOP_N=5
JINA_API_KEY=jina_7              # only needed if RERANKER_BACKEND=jina

# Feature flags
IMAGE_CAPTION_ENABLED=true
s
# API server    
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Logging
LOG_JSON=false   # true = JSON lines for log aggregators
