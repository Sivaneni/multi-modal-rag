endobj
1346 0 obj
<<
/Type /StructElem
/S /P
/E (Pod Eviction: Kubernetes evicts lower-priority pods to free up disk space, which can cause disruptions in non critical workloads.)
/Alt ()
/Pg 59 0 R
/K [2]
>>
endobj
1347 0 obj
<<
/Type /StructElem
/S /P
/E (Scheduling Failures: New workloads may not deploy if nodes are in a Disk Pressure state.)
/Alt ()
/Pg 59 0 R
/K [3]
>>
endobj
1348 0 obj
<<
/Type /StructElem
/S /P
